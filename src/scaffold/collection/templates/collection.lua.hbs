crap.collections.define("{{slug}}", {
    labels = {
        singular = "{{label_singular}}",
        plural = "{{label_plural}}",
    },
    timestamps = {{timestamps}},
{{#if auth}}
    auth = true,
    -- `auth = true` expands to the standard three methods:
    --   password_login + bearer (all surfaces) + session_cookie (admin).
    -- Customize by listing methods explicitly:
    --
    -- auth = {
    --     enabled = true,
    --     methods = crap.auth.with_defaults({
    --         { type = "strategy",
    --           name = "api-key",
    --           authenticate = "hooks.auth.api_key",
    --           activates_on = { header = "x-api-key" },
    --           surfaces = { "grpc" } },
    --     }),
    -- },
    --
    -- To require email verification or enable MFA, tweak the
    -- password_login entry:
    --
    -- auth = {
    --     enabled = true,
    --     methods = {
    --         { type = "password_login", verify_email = true, mfa = "email" },
    --         { type = "bearer", surfaces = { "grpc", "admin" } },
    --         { type = "session_cookie", surfaces = { "admin" } },
    --     },
    -- },
{{/if}}
{{#if upload}}
    upload = true,
    -- Full upload config (uncomment and customize):
    -- upload = {
    --     mime_types = { "image/*", "application/pdf" },
    --     max_file_size = "50MB",
    --     image_sizes = {
    --         { name = "thumbnail", width = 300, height = 300, fit = "cover" },
    --     },
    -- },
{{/if}}
{{#if versions}}
    versions = true,
{{/if}}
    admin = {
{{#if title_field}}
        use_as_title = "{{title_field}}",
{{/if}}
{{#unless no_timestamps}}
        default_sort = "-created_at",
{{/unless}}
{{#if title_field}}
        list_searchable_fields = { "{{title_field}}" },
{{/if}}
    },
    fields = {
{{{fields_lua}}}    },
    -- access = {
    --     read   = "access.anyone",
    --     create = "access.authenticated",
    --     update = "access.authenticated",
    --     delete = "access.admin_only",
