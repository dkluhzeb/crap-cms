crap_version = "{{version}}"

[server]
admin_port = {{admin_port}}
grpc_port = {{grpc_port}}
host = "0.0.0.0"
# compression = "off"             # "off" (default), "gzip", "br", "all"
# grpc_reflection = false          # enable gRPC server reflection (default: false)
# grpc_rate_limit_requests = 0    # per-IP request limit (0 = disabled)
# grpc_rate_limit_window = 60     # sliding window in seconds (or "1m")
# grpc_max_message_size = "16MB"  # max gRPC message size (default 16MB)
# grpc_timeout = "30s"            # per-RPC deadline (unset = none); exceeding it returns DEADLINE_EXCEEDED
# request_timeout = "30s"         # admin HTTP request timeout (unset = none; SSE exempt)
# h2c = false                     # HTTP/2 cleartext for TLS-terminating reverse proxies
# public_url = ""                 # public base URL for generated links (password reset emails etc.)
# public_schema_introspection = true # gRPC ListCollections/DescribeCollection without auth
# bulk_max_documents = 0          # max documents per bulk op (0 = no limit)
# trust_proxy = false             # trust X-Forwarded-For (admin HTTP only)
# trusted_proxies = ["10.0.0.0/8"] # REQUIRED when trust_proxy = true; accepts IPs, CIDRs, or "*"

[database]
path = "data/crap.db"
# backend = "sqlite"             # "sqlite" (default) or "postgres" (requires --features postgres)
# url = "host=localhost user=crap dbname=crap_cms"  # PostgreSQL connection string (backend = "postgres")
# pool_max_size = 64             # max connections in the READ pool
# write_pool_max_size = 4        # max connections in the WRITE pool (SQLite only)
# busy_timeout = "30s"          # SQLite busy timeout (ms or "30s", "1m")
# connection_timeout = 30         # pool checkout timeout (seconds or "30s")
# cache_size = -16384            # page cache in KB (negative = KB; default 16MB)
# mmap_size = 268435456          # memory-mapped I/O in bytes (default 256MB, 0 = off)
# wal_autocheckpoint = 1000      # WAL auto-checkpoint threshold in pages
# stmt_cache_capacity = 128      # per-connection prepared-statement cache (SQLite)

[admin]
dev_mode = false
# site_name = "Crap CMS"            # display name in the admin header + <title>
# default_timezone = ""             # default IANA timezone for date fields with timezone = true
# require_auth = true               # block admin when no auth collection exists (default: true)
# access = "access.admin_panel"     # Lua function: which users can access the admin UI
# csrf_cookie_lifetime = "24h"      # lifetime of the crap_csrf double-submit cookie

# [admin.csp]                       # Content-Security-Policy header (enabled by default)
# enabled = true
# script_src ships without 'unsafe-inline' -- a per-request nonce is emitted
# instead and exposed to templates as {{crap.csp_nonce}}. Overlay templates
# that use inline <script> MUST carry nonce="{{crap.csp_nonce}}".
# default_src = ["'self'"]         # fallback for directives not set explicitly
# script_src = ["'self'"]
# style_src = ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"]
# font_src = ["'self'", "https://fonts.gstatic.com"]
# img_src = ["'self'", "data:"]
# connect_src = ["'self'"]
# frame_ancestors = ["'none'"]
# form_action = ["'self'"]
# base_uri = ["'self'"]

[auth]
secret = "{{{auth_secret}}}"
# token_expiry = 7200              # seconds, default 2 hours
# max_login_attempts = 5           # failed logins per email before lockout
# max_ip_login_attempts = 20       # failed logins per IP before lockout (higher: shared IPs)
# login_lockout_seconds = 300      # lockout duration (5 minutes)
# reset_token_expiry = 3600        # password reset token lifetime (1 hour)
# max_forgot_password_attempts = 3 # rate limit forgot-password per email
# forgot_password_window_seconds = 900  # rate limit window (15 minutes)
# session_cookie_samesite = "lax"  # "lax" (default) or "strict"
# session_absolute_max_age = "30d" # hard cap on cumulative session lifetime from login (0 = disabled)
# rate_limit_backend = "memory"    # "memory" (default), "redis" (shared across nodes), or "none"
# rate_limit_redis_url = ""        # Redis URL for the redis backend (falls back to cache.redis_url)
# rate_limit_prefix = "crap:rl:"   # key prefix for the Redis rate-limit backend

# [auth.password_policy]
# min_length = 12               # minimum password length
# max_length = 128              # maximum password length
# require_uppercase = false     # require uppercase letter
# require_lowercase = false     # require lowercase letter
# require_digit = false         # require digit
# require_special = false       # require special character

[live]
# enabled = true                # enable SSE + gRPC Subscribe for live mutation events
# transport = "memory"          # "memory" (default) -- in-process events, or "redis" -- cross-node fanout via Redis pub/sub (requires --features redis, reuses cache.redis_url)
# channel_capacity = 1024       # broadcast channel buffer size
# max_sse_connections = 1000    # max concurrent SSE connections (0 = unlimited)
# max_subscribe_connections = 1000  # max concurrent gRPC Subscribe streams (0 = unlimited)
# subscriber_send_timeout_ms = 1000  # drop slow subscribers whose send exceeds this (ms)

{{#if has_locales}}
[locale]
default_locale = "{{default_locale}}"
locales = [{{{locales_str}}}]
fallback = true
{{else}}
# [locale]
# default_locale = "en"         # default locale for content
# locales = ["en", "de"]        # supported locales (empty = disabled)
# fallback = true               # fall back to default locale if field is empty
{{/if}}

# [depth]
# default_depth = 1              # default relationship population depth for FindByID
# max_depth = 10                 # hard cap on population depth
# max_nesting_depth = 64         # max nesting depth for JSON data structures (e.g. a Lua
#                                # table a hook builds). Distinct from max_depth (population).
#                                # Must be >= max_depth; values > 128 won't round-trip through
#                                # the JSON parser.

# [cache]
# backend = "memory"             # cache backend: "memory" (default), "redis", "none"
# max_entries = 10000             # soft cap for memory backend
# max_age_secs = 0                # periodic full clear (0 = disabled, only write-through invalidation)
# redis_url = "redis://127.0.0.1:6379"  # Redis URL (only for redis backend)
# prefix = "crap:"               # key prefix for Redis

# [pagination]
# default_limit = 20            # default page size when no limit specified
# max_limit = 1000               # maximum allowed limit (requests above this are clamped)
# mode = "page"                  # pagination mode: "page" (offset-based) or "cursor" (keyset-based)

# [upload]
# storage = "local"              # "local" (default), "s3" (requires --features s3-storage), or "custom"
# max_file_size = "50MB"         # global max upload size (integer bytes or "50MB", "1GB")
# [upload.s3]                    # S3-compatible storage (MinIO, R2, B2, etc.)
# bucket = "my-uploads"
# region = "us-east-1"
# endpoint = ""                  # custom endpoint for non-AWS providers
# access_key = "${AWS_ACCESS_KEY}"
# secret_key = "${AWS_SECRET_KEY}"
# path_style = false             # true for MinIO
# prefix = ""                    # optional key prefix prepended to all storage keys

# [email]
# provider = "smtp"               # "smtp" (default), "webhook", "log", or "custom"
# smtp_host = ""                 # SMTP server (empty = falls back to log provider)
# smtp_port = 587
# smtp_user = ""
# smtp_pass = ""
# smtp_tls = "starttls"           # "starttls" (default), "tls" (implicit), "none" (plain)
                                  # "none" + non-loopback host logs a startup warning
# from_address = "noreply@example.com"
# from_name = "Crap CMS"
# smtp_timeout = 30               # SMTP connection/send timeout (seconds or "30s")
# webhook_url = ""               # URL for webhook provider (POST JSON)
# webhook_headers = {}            # extra HTTP headers for webhook

# [hooks]
# on_init = []                   # hook functions to run at startup
# max_depth = 3                  # max hook recursion depth (hook > CRUD > hook)
# vm_pool_size = 8               # Lua VMs pre-warmed at startup (default: number of CPU cores)
# max_vm_pool_size = 64          # hard cap; pool grows on demand up to this (default: cores*8, min 32)
# max_instructions = 10000000    # max Lua instructions per hook invocation
# max_memory = "50MB"            # max Lua memory per VM
# allow_private_networks = false # allow Lua HTTP requests to private/internal networks
# http_max_response_bytes = "10MB" # max HTTP response body size for crap.http.request

# [jobs]
# max_concurrent = 10             # cluster-wide cap on concurrent jobs (counted via DB)
# poll_interval = 1              # seconds between job queue polls
# cron_interval = 60             # seconds between cron schedule checks
# heartbeat_interval = 10        # seconds between running job heartbeats
# auto_purge = 604800            # auto-purge completed/failed jobs older than N seconds (7 days)
# priority_decay = 0              # priority aging period (e.g. "1m") — 0 disables (pure static priority)

# Per-queue aggregate concurrency caps (all caps in jobs are cluster-wide).
# Strictest of: max_concurrent / queue cap / per-slug JobDefinition::concurrency
# wins. Queues without an entry are unconstrained beyond the global cap.
#
# Framework defaults applied if not overridden:
#   images = { concurrency = 2 }   — AVIF/WebP encoders are CPU-bound
#   bulk   = { concurrency = 1 }   — queued bulk operations run one at a time
[jobs.queues]
# Per-queue knobs: { concurrency, timeout, retries }. Operator-supplied
# fields override the framework defaults; unspecified fields keep them.
# Framework defaults: images = { concurrency = 2, timeout = "5m", retries = 2 }
#                     email  = { concurrency = 5, timeout = "30s", retries = 3 }
images = { concurrency = 2 }
# email   = { concurrency = 8, timeout = "1m", retries = 5 }
# reports = { concurrency = 1, timeout = "30m", retries = 0 }

# [cors]
# allowed_origins = []           # empty = CORS disabled; ["*"] = allow any origin
# allowed_methods = ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
# allowed_headers = ["Content-Type", "Authorization"]
# exposed_headers = []           # response headers exposed to the browser
# max_age = 3600                   # seconds or human-readable ("1h", "30m")
# allow_credentials = false      # cannot be used with wildcard origin

# [routes]
# prefix = ""                    # URL prefix for all custom Lua routes (e.g. "/api")
# max_body = "1MB"               # default request body limit (per-route max_body overrides)

# [access]
# default_deny = true            # when true (default), collections without access functions deny all

# [logging]
# file = false                   # enable file logging (default: false, auto-enabled with --detach)
# path = "data/logs"             # log directory (relative to config dir, or absolute)
# rotation = "daily"             # rotation strategy: "daily", "hourly", or "never"
# max_files = 30                 # rotated files to keep (pruned on startup)

# [mcp]
# enabled = false                # enable MCP (Model Context Protocol) server
# http = false                   # enable HTTP transport on /mcp (POST)
# config_tools = false           # enable config generation tools (write access to config dir)
# job_tools = "read"              # job MCP tools: false (none), "read", or "all" (adds trigger/cancel)
# api_key = ""                   # required when http = true; minimum 32 chars
                                  # generate with: openssl rand -hex 32
# http_max_body_bytes = "1MB"    # max POST /mcp body size (int bytes or "16MB" string)
# include_collections = []       # whitelist (empty = all)
# exclude_collections = []       # blacklist (takes precedence over include)

# [update]
# check_on_startup = true        # print a notice on serve startup when a newer release is cached
