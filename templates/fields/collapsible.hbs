<crap-collapsible>
  <div
    class="form__collapsible{{#if collapsed}} form__collapsible--collapsed{{/if}}"
    data-collapsible
    data-group-name="{{name}}"
    data-field-name="{{name}}"
  >
    <button
      type="button"
      class="form__collapsible-toggle"
      data-action="toggle-group"
      aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
    >
      <span
        class="form__group-chevron material-symbols-outlined"
        aria-hidden="true"
      >
        expand_more
      </span>
      {{t label}}
    </button>
    <div class="form__collapsible-body">
      {{#each sub_fields}}
        <div
          class="form__field{{#if width}} form__field--sized form__field--{{width}}{{/if}}{{#if (eq condition_visible false)}} form__field--hidden{{/if}}"
          {{#if condition_json}}data-condition='{{{json condition_json}}}'{{/if}}
          {{#if condition_ref}}data-condition-ref="{{condition_ref}}"{{/if}}
          {{#if width_value}}data-field-width="{{width_value}}"{{/if}}
          data-field-name="{{name}}"
        >
          {{{render_field this}}}
        </div>
      {{/each}}
    </div>
    {{#if error}}
      <p class="form__error">{{error}}</p>
    {{/if}}
    {{#if description}}
      <p class="form__help">{{t description}}</p>
    {{/if}}
  </div>
</crap-collapsible>
