<crap-sidebar>
  <aside class="sidebar">
    <nav class="sidebar__navigation">
      <ul>
        <li>
          <a
            class="link link--ghost"
            href="/admin"
            hx-get="/admin"
            hx-target="#main"
            hx-swap="innerHTML show:window:top"
            hx-push-url="true"
          >
            <span class="material-symbols-outlined">dashboard</span>
            {{t "dashboard"}}
          </a>
        </li>
        {{#each nav.collections}}
          <li>{{> layout/sidebar_item}}</li>
        {{/each}}
        {{#each nav.globals}}
          <li>{{> layout/sidebar_global_item}}</li>
        {{/each}}
        {{#each nav.custom_page_sections}}
          {{#if heading}}
            <li class="sidebar__section-heading">{{heading}}</li>
          {{/if}}
          {{#each pages}}
            <li>
              <a
                class="link link--ghost"
                href="/admin/p/{{slug}}"
                hx-get="/admin/p/{{slug}}"
                hx-target="#main"
                hx-swap="innerHTML show:window:top"
                hx-push-url="true"
              >
                {{#if icon}}
                  <span class="material-symbols-outlined">{{icon}}</span>
                {{/if}}
                {{label}}
              </a>
            </li>
          {{/each}}
        {{/each}}
      </ul>

      {{slot "sidebar_bottom"}}
    </nav>
  </aside>
</crap-sidebar>
