{{#> layout/auth title=(t "mfa_page_title")}}

  {{#if error}}
    <div class="auth-card__error">{{t error}}</div>
  {{/if}}

  {{#if totp}}
    <p class="auth-card__message">{{t "mfa_totp_enter_code"}}</p>
    {{#if totp_provisioning_uri}}
      <div class="auth-card__totp-setup">
        <p>{{t "mfa_totp_setup"}}</p>
        <p>
          {{! Triple-stash: the URI is fully server-constructed (percent-encoded
          account, base32 secret); default escaping would mangle its `=`
          separators into &#x3D;. }}
          <a href='{{{totp_provisioning_uri}}}'>{{t "mfa_totp_open_app"}}</a>
        </p>
        <p>
          {{t "mfa_totp_manual_key"}}:
          <code>{{totp_secret}}</code>
        </p>
      </div>
    {{/if}}
  {{else}}
    <p class="auth-card__message">{{t "mfa_enter_code"}}</p>
  {{/if}}

  <form
    class="auth-card__form"
    method="POST"
    action="/admin/mfa"
  >
    <div class="form__field">
      <label for="code">{{t "mfa_code_label"}}</label>
      <input
        type="text"
        name="code"
        id="code"
        placeholder="000000"
        required
        autocomplete="one-time-code"
        inputmode="numeric"
        pattern="[0-9]{6}"
        maxlength="6"
        autofocus
      />
    </div>

    <button
      type="submit"
      class="button button--primary auth-card__submit"
    >
      {{t "mfa_verify"}}
    </button>

    <p class="auth-card__link">
      <a href="/admin/login">{{t "back_to_login"}}</a>
    </p>
  </form>

{{/layout/auth}}
